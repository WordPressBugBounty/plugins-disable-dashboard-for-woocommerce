msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:623
msgid "Disable WooCommerce Marketplace Suggestions"
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:624
msgid "This option will disable Marketplace Suggestions and promotions. Suggestions are visible on the product edit page and on the Orders pages. It also turns off the \"Show suggestions\" setting in WooCommerce > Settings > Advanced > WooCommerce.com, which stops payment, shipping and extension recommendations and remote inbox notes from being fetched."
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:634
msgid "Disable Extensions & My Subscriptions submenus"
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:635
msgid "Hide Extensions & My Subscriptions submenus in the WooCommerce menu in your admin panel menu. <strong>Reload the page after saving changes to see the results.</strong>"
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:645
msgid "Disable Recommended shipping solutions metabox"
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:646
msgid "Recommended shipping solutions metabox is appearing on Shipping configurations pages in WooCommerce and is primarily used for advertisement."
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:656
msgid "Disable Recommended payments solutions metabox"
msgstr ""

#: includes/settings/class-disable-bloat-settings-main.php:657
msgid "Recommended payments solutions metabox is appearing on Payments configurations pages in WooCommerce and is primarily used for advertisement."
